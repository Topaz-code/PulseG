# build output - the workflow rebuilds it - and it is large, so it is not committed.
src-tauri/binaries/

# --- Secrets & local runtime state (NEVER commit) ---
keys.enc
*.enc
.env
.env.*
!.env.example
config.yaml
projects.json

# --- Build artifacts ---
release/
*.exe
!scripts/**/*.exe
*.msi
*.AppImage
*.dmg
*.deb

# --- Project runtime data (generated on user machines) ---
pulsegstudio-projects/
demo-projects/
.web-build-cache/

# --- Editors / OS ---
